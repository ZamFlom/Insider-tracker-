# dependencies
/node_modules
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*
!.env.example

# local runtime data (signups, submissions, searches, clicks)
# These are stored in /tmp on Vercel and in ./data locally; never commit them.
# (The seed data in src/data/clusters.json IS committed — it is the site content.)
/data/*
!/data/.gitkeep
